---
import { NAV_ITEMS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header" data-site-header>
	<div class="header-inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE}首页`}>
			<span class="brand-mark" aria-hidden="true">知</span>
			<span class="brand-copy">
				<strong>{SITE_TITLE}</strong>
				<small>技术与成长手记</small>
			</span>
		</a>

		<nav class="site-nav" aria-label="主导航">
			{NAV_ITEMS.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</nav>

		<a class="header-note" href="/about/">
			<span>记录 · 实践 · 复盘</span>
			<span aria-hidden="true">↗</span>
		</a>
	</div>
</header>

<script>
	const siteHeader = document.querySelector<HTMLElement>('[data-site-header]');
	let frameRequested = false;

	const updateHeader = () => {
		siteHeader?.classList.toggle('is-compact', window.scrollY > 18);
		frameRequested = false;
	};

	const requestHeaderUpdate = () => {
		if (frameRequested) return;
		frameRequested = true;
		window.requestAnimationFrame(updateHeader);
	};

	updateHeader();
	window.addEventListener('scroll', requestHeaderUpdate, { passive: true });
	window.addEventListener('pageshow', updateHeader);
</script>

<style>
	.site-header {
		--header-height: 72px;
		position: sticky;
		z-index: 50;
		top: 8px;
		width: min(1120px, calc(100% - 48px));
		margin: 8px auto 0;
		border: 1px solid transparent;
		border-radius: 999px;
		background: transparent;
		transition:
			background-color 320ms ease,
			border-color 320ms ease,
			box-shadow 320ms ease,
			backdrop-filter 320ms ease;
	}

	.site-header.is-compact {
		--header-height: 58px;
		border-color: color-mix(in srgb, var(--ink) 10%, transparent);
		background: color-mix(in srgb, var(--paper-light) 72%, transparent);
		box-shadow:
			0 12px 34px rgb(23 34 28 / 8%),
			inset 0 1px 0 rgb(255 255 255 / 74%);
		backdrop-filter: blur(18px) saturate(125%);
		-webkit-backdrop-filter: blur(18px) saturate(125%);
	}

	.header-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		min-height: var(--header-height);
		padding: 6px 18px;
		gap: 42px;
		transition:
			min-height 360ms cubic-bezier(0.22, 1, 0.36, 1),
			padding 360ms cubic-bezier(0.22, 1, 0.36, 1),
			gap 360ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		text-decoration: none;
		transition: gap 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.brand-mark {
		display: grid;
		width: 40px;
		height: 40px;
		place-items: center;
		border-radius: 13px 13px 13px 4px;
		background: var(--green);
		color: var(--paper-light);
		font-family: "Noto Serif SC", "Songti SC", serif;
		font-size: 20px;
		font-weight: 700;
		box-shadow: 0 8px 22px rgb(23 63 53 / 18%);
		transition:
			width 320ms cubic-bezier(0.22, 1, 0.36, 1),
			height 320ms cubic-bezier(0.22, 1, 0.36, 1),
			border-radius 320ms ease,
			font-size 320ms ease,
			box-shadow 320ms ease;
	}

	.brand-copy {
		display: flex;
		flex-direction: column;
		line-height: 1.08;
	}

	.brand-copy strong {
		font-family: "Noto Serif SC", "Songti SC", serif;
		font-size: 21px;
		letter-spacing: 0.12em;
		transition:
			font-size 300ms ease,
			letter-spacing 300ms ease;
	}

	.brand-copy small {
		margin-top: 5px;
		color: var(--muted);
		font-size: 10px;
		letter-spacing: 0.15em;
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 180ms ease,
			transform 240ms ease,
			margin 240ms ease;
	}

	.site-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 30px;
	}

	.header-note {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--muted);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-decoration: none;
		opacity: 1;
		transition:
			color 160ms ease,
			opacity 220ms ease;
	}

	.header-note:hover {
		color: var(--accent);
	}

	.site-header.is-compact .header-inner {
		padding: 4px 16px;
		gap: 34px;
	}

	.site-header.is-compact .brand {
		gap: 9px;
	}

	.site-header.is-compact .brand-mark {
		width: 32px;
		height: 32px;
		border-radius: 10px 10px 10px 3px;
		font-size: 17px;
		box-shadow: 0 5px 14px rgb(23 63 53 / 14%);
	}

	.site-header.is-compact .brand-copy strong {
		font-size: 18px;
		letter-spacing: 0.09em;
	}

	.site-header.is-compact .brand-copy small {
		margin-top: 0;
		opacity: 0;
		transform: translateY(-4px);
	}

	.site-header.is-compact .header-note {
		opacity: 0.68;
	}

	@media (max-width: 820px) {
		.site-header {
			--header-height: 66px;
			top: 6px;
			width: min(100% - 32px, 1120px);
			margin-top: 6px;
		}

		.site-header.is-compact {
			--header-height: 56px;
		}

		.header-inner {
			grid-template-columns: auto 1fr;
			padding-inline: 14px;
			gap: 22px;
		}

		.site-nav {
			justify-content: flex-end;
			gap: 18px;
		}

		.header-note {
			display: none;
		}

		.site-header.is-compact .header-inner {
			gap: 18px;
			padding-inline: 13px;
		}
	}

	@media (max-width: 620px) {
		.site-header {
			--header-height: auto;
			border-radius: 24px;
		}

		.site-header.is-compact {
			--header-height: auto;
		}

		.header-inner {
			grid-template-columns: 1fr;
			min-height: auto;
			padding: 10px 14px 9px;
			gap: 9px;
		}

		.brand-copy small {
			display: none;
		}

		.brand-mark,
		.site-header.is-compact .brand-mark {
			width: 34px;
			height: 34px;
			border-radius: 11px 11px 11px 3px;
			font-size: 18px;
		}

		.brand-copy strong,
		.site-header.is-compact .brand-copy strong {
			font-size: 19px;
		}

		.site-nav {
			width: 100%;
			justify-content: flex-start;
			gap: 20px;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.site-nav::-webkit-scrollbar {
			display: none;
		}

		.site-nav :global(a) {
			flex: none;
			padding-block: 5px;
			font-size: 13px;
		}

		.site-header.is-compact .header-inner {
			padding: 8px 14px 7px;
			gap: 7px;
		}
	}
</style>
