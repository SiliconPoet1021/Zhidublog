---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTagCounts, getTagHref } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = getTagCounts(posts);

	return tags.map(({ tag }) => ({
		params: { tag },
		props: { tag },
	}));
}

const { tag } = Astro.props as { tag: string };
const allPosts = await getPublishedPosts();
const posts = allPosts.filter((post) => post.data.tags.includes(tag));
const relatedTags = getTagCounts(posts).filter((item) => item.tag !== tag);
---

<BaseLayout
	title={`标签：${tag}`}
	description={`浏览与“${tag}”相关的 ${posts.length} 篇文章，涵盖技术实践、项目复盘和成长记录。`}
>
	<section class="page-hero">
		<div class="container page-hero-grid">
			<div>
				<p class="eyebrow">TOPIC · TAG</p>
				<h1 class="page-title">#{tag}</h1>
				<p class="page-description">
					围绕“{tag}”整理的 {posts.length} 篇记录。标签页会把散落在不同时间和分类里的相关内容连接起来。
				</p>
			</div>
			<div class="tag-side-note">
				<p>相关标签</p>
				<div class="tag-list">
					{
						relatedTags.slice(0, 8).map((item) => (
							<a class="tag" href={getTagHref(item.tag)}>
								{item.tag}
							</a>
						))
					}
					<a class="tag" href="/tags/">全部标签</a>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="eyebrow">RELATED NOTES</p>
					<h2>标签下的文章</h2>
				</div>
				<a class="text-link" href="/blog/">全部文章</a>
			</div>

			<div class="post-grid">
				{posts.map((post, index) => <PostCard post={post} featured={index === 0} />)}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.tag-side-note {
		padding: 22px 0 4px 24px;
		border-left: 2px solid var(--gold);
	}

	.tag-side-note > p {
		margin-bottom: 12px;
		color: var(--ink);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.tag-side-note .tag {
		background: rgb(255 253 247 / 64%);
	}

	.tag-side-note .tag:hover {
		color: var(--accent);
	}
</style>
