---
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_META, SITE_DESCRIPTION, type CategoryKey } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const categories = Object.entries(CATEGORY_META) as [
	CategoryKey,
	(typeof CATEGORY_META)[CategoryKey],
][];
---

<BaseLayout title="文章与记录" description={SITE_DESCRIPTION}>
	<section class="page-hero">
		<div class="container page-hero-grid">
			<div>
				<p class="eyebrow">WRITING ARCHIVE</p>
				<h1 class="page-title">文章与记录</h1>
				<p class="page-description">
					技术不是孤立的答案，成长也不是一句口号。这里保存项目中的判断、工作中的问题，以及那些后来才想明白的事。
				</p>
			</div>
			<p class="page-hero-note">
				“写作让我重新检查自己的判断。<br />如果一篇文章无法帮助解决具体问题，它可能还没写完。”
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="blog-tools">
				<label class="blog-search">
					<span class="sr-only">搜索文章</span>
					<svg viewBox="0 0 20 20" aria-hidden="true">
						<circle cx="8.5" cy="8.5" r="5.5"></circle>
						<path d="m13 13 4 4"></path>
					</svg>
					<input
						id="blogSearch"
						type="search"
						placeholder="搜索标题、摘要或标签…"
						autocomplete="off"
					/>
				</label>
				<p id="blogSearchSummary" class="blog-search-summary" aria-live="polite">
					共 {posts.length} 篇记录
				</p>
			</div>

			<nav class="category-filter" aria-label="文章分类">
				<a class="category-pill is-active" href="/blog/" aria-current="page">全部</a>
				{
					categories.map(([key, category]) => (
						<a class="category-pill" href={`/categories/${key}/`}>
							{category.label}
						</a>
					))
				}
			</nav>

			{
				posts.length > 0 ? (
					<div id="blogPostGrid" class="post-grid">
						{posts.map((post, index) => (
							<div
								class="post-grid-item"
								data-search={[post.data.title, post.data.description, ...post.data.tags]
									.join(' ')
									.toLocaleLowerCase('zh-CN')}
							>
								<PostCard post={post} featured={index === 0} />
							</div>
						))}
					</div>
					<div id="blogEmptySearch" class="empty-state" hidden>
						没有找到匹配的文章，换个关键词试试。
					</div>
				) : (
					<div class="empty-state">第一篇文章正在整理中。</div>
				)
			}
		</div>
	</section>
</BaseLayout>

<script>
	const searchInput = document.querySelector<HTMLInputElement>('#blogSearch');
	const summary = document.querySelector<HTMLElement>('#blogSearchSummary');
	const items = Array.from(document.querySelectorAll<HTMLElement>('.post-grid-item'));
	const emptyState = document.querySelector<HTMLElement>('#blogEmptySearch');

	const updateSearch = () => {
		if (!searchInput) return;

		const query = searchInput.value.trim().toLocaleLowerCase('zh-CN');
		let visibleCount = 0;

		items.forEach((item) => {
			const matches = !query || (item.dataset.search || '').includes(query);
			item.hidden = !matches;
			if (matches) visibleCount += 1;
		});

		if (summary) {
			summary.textContent = query
				? `找到 ${visibleCount} 篇相关记录`
				: `共 ${items.length} 篇记录`;
		}

		if (emptyState) emptyState.hidden = visibleCount > 0;
	};

	searchInput?.addEventListener('input', updateSearch);
	searchInput?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			searchInput.value = '';
			updateSearch();
			searchInput.blur();
		}
	});
</script>

<style>
	.blog-tools {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 18px;
	}

	.blog-search {
		display: flex;
		width: min(100%, 480px);
		height: 48px;
		align-items: center;
		gap: 10px;
		padding: 0 16px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: rgb(255 253 247 / 58%);
		transition:
			border-color 160ms ease,
			background 160ms ease,
			box-shadow 160ms ease;
	}

	.blog-search:focus-within {
		border-color: var(--green);
		background: var(--paper-light);
		box-shadow: 0 0 0 4px rgb(23 63 53 / 6%);
	}

	.blog-search svg {
		width: 17px;
		flex: none;
		fill: none;
		stroke: var(--muted);
		stroke-width: 1.6;
	}

	.blog-search input {
		width: 100%;
		min-width: 0;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--ink);
		font-size: 13px;
	}

	.blog-search input::placeholder {
		color: color-mix(in srgb, var(--muted) 72%, transparent);
	}

	.blog-search-summary {
		flex: none;
		color: var(--muted);
		font-size: 11px;
		letter-spacing: 0.04em;
	}

	.post-grid-item {
		min-width: 0;
	}

	.post-grid > :global(:first-child) {
		grid-column: 1 / -1;
	}

	@media (max-width: 820px) {
		.post-grid > :global(:first-child) {
			grid-column: auto;
		}
	}

	@media (max-width: 640px) {
		.blog-tools {
			align-items: stretch;
			flex-direction: column;
			gap: 10px;
		}

		.blog-search {
			width: 100%;
		}

		.blog-search-summary {
			padding-left: 4px;
		}
	}
</style>
